# Copy this template to a private file outside the repository.
# Compose intentionally uses BUDBOT_PRODUCTION_* names so it cannot inherit
# the development values from the repository's .env file.

BUDBOT_PRODUCTION_DATABASE_NAME=budbot_production
BUDBOT_PRODUCTION_DATABASE_USER=budbot_app
# Generate a URL-safe value for a fresh installation, for example with
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BUDBOT_PRODUCTION_DATABASE_PASSWORD=

# Generate a unique value of at least 32 bytes, for example with:
# openssl rand -hex 32
BUDBOT_PRODUCTION_ADMIN_LOGIN_RATE_LIMIT_KEY=

# Required for production; URL-safe base64 of 32 cryptographically random bytes.
# Generate once for a new installation and store privately. Never regenerate
# this for an installation that has saved encrypted provider credentials.
# See docs/configuration.md for secure generation guidance.
BUDBOT_PRODUCTION_PROVIDER_ROOT_KEY=

BUDBOT_PRODUCTION_HTTP_PORT=18000
BUDBOT_PRODUCTION_AI_TENANT_ENABLED=true
# JSON list of explicitly approved OpenAI-compatible endpoint URLs.
BUDBOT_PRODUCTION_AI_COMPATIBLE_ENDPOINTS=[]
