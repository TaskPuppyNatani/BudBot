# Copy to .env for local development. These are non-secret development values.
BUDBOT_ENVIRONMENT=development
BUDBOT_DATABASE_URL=postgresql+asyncpg://budbot:budbot_dev@localhost:5432/budbot
BUDBOT_DATABASE_POOL_SIZE=5
BUDBOT_DATABASE_MAX_OVERFLOW=10
BUDBOT_DATABASE_CONNECT_TIMEOUT_SECONDS=5
BUDBOT_DATABASE_READINESS_TIMEOUT_SECONDS=2
# Customer website/session lifetime in seconds (24 hours by default).
BUDBOT_CUSTOMER_SESSION_TTL_SECONDS=86400

# AI is disabled by default. For a local OpenAI-compatible server, configure
# these values in the operator's private .env file and explicitly enable tools
# only after verifying the selected model/harness combination.
BUDBOT_AI_ENABLED=false
# BUDBOT_AI_PROVIDER=openai_compatible
# BUDBOT_AI_BASE_URL=http://host.docker.internal:1234/v1
# BUDBOT_AI_MODEL=replace-with-configured-model
# BUDBOT_AI_HARNESS=generic_openai
# BUDBOT_AI_API_KEY=replace-with-secret-if-required
BUDBOT_AI_TIMEOUT_SECONDS=30
BUDBOT_AI_CONNECT_TIMEOUT_SECONDS=5
BUDBOT_AI_MAX_OUTPUT_TOKENS=800
BUDBOT_AI_CAPABILITY_TEXT_GENERATION=true
BUDBOT_AI_CAPABILITY_TOOL_CALLING=false
BUDBOT_AI_CAPABILITY_USAGE_REPORTING=false
BUDBOT_AI_CAPABILITY_TEMPERATURE=false
BUDBOT_AI_CAPABILITY_MAX_OUTPUT_TOKENS=true
BUDBOT_AI_CAPABILITY_STRUCTURED_OUTPUT=false
BUDBOT_AI_CAPABILITY_SYSTEM_ROLE=true
BUDBOT_AI_CAPABILITY_REASONING_CONTROL=false

# Used by the PostgreSQL container in docker-compose.dev.yml.
BUDBOT_DATABASE_NAME=budbot
BUDBOT_DATABASE_USER=budbot
BUDBOT_DATABASE_PASSWORD=budbot_dev
