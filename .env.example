# Copy to .env for local development. These are non-secret development values.
BUDBOT_ENVIRONMENT=development
BUDBOT_DATABASE_URL=postgresql+asyncpg://budbot:budbot_dev@localhost:5432/budbot
BUDBOT_DATABASE_POOL_SIZE=5
BUDBOT_DATABASE_MAX_OVERFLOW=10
BUDBOT_DATABASE_CONNECT_TIMEOUT_SECONDS=5
BUDBOT_DATABASE_READINESS_TIMEOUT_SECONDS=2
# Customer website/session lifetime in seconds (24 hours by default).
BUDBOT_CUSTOMER_SESSION_TTL_SECONDS=86400
# Administrative sessions expire after 8 hours by default, capped at 24 hours.
BUDBOT_ADMIN_SESSION_TTL_SECONDS=28800
BUDBOT_ADMIN_LOGIN_FAILURE_LIMIT=5
BUDBOT_ADMIN_LOGIN_WINDOW_SECONDS=900
BUDBOT_ADMIN_LOGIN_LOCKOUT_SECONDS=900
# Required in production; generate a unique key with: openssl rand -hex 32
# Keep the real value in the deployment secret store, never in Git.
# BUDBOT_ADMIN_LOGIN_RATE_LIMIT_KEY=replace-with-a-unique-random-secret
# Invitation links expire after 7 days by default (900 seconds to 14 days).
BUDBOT_ADMIN_INVITATION_TTL_SECONDS=604800

# Deployment-wide switch for persisted tenant AI profiles.
BUDBOT_AI_TENANT_ENABLED=true
# JSON list of deployment-approved OpenAI-compatible endpoints; empty denies all.
# Endpoints must be reachable from the backend container and operator-controlled.
BUDBOT_AI_COMPATIBLE_ENDPOINTS=[]
# Example private override: ["http://host.docker.internal:1234/v1"]
# Generate once: URL-safe base64 of 32 cryptographically random bytes.
# See docs/configuration.md for generation directly into private configuration.
# Keep this key persistent and private, backed up separately from the database.
# NEVER regenerate it for an existing installation containing encrypted credentials.
# BUDBOT_PROVIDER_ROOT_KEY=replace-with-persistent-private-encryption-key
# Optional: bind legacy/global AI settings to exactly one authorized business UUID.
# Unconfigured tenants otherwise do not inherit global provider credentials.
# BUDBOT_AI_LEGACY_BUSINESS_ID=replace-with-authorized-business-uuid

# Legacy/global AI is disabled by default. Configure these values in the
# operator's private .env for a local OpenAI-compatible server; enable tools
# only after verifying the selected model/harness combination.
BUDBOT_AI_ENABLED=false
# BUDBOT_AI_PROVIDER=openai_compatible
# BUDBOT_AI_BASE_URL=http://host.docker.internal:1234/v1
# BUDBOT_AI_MODEL=replace-with-configured-model
# BUDBOT_AI_HARNESS=generic_openai
# BUDBOT_AI_API_KEY=replace-with-secret-if-required
BUDBOT_AI_TIMEOUT_SECONDS=30
BUDBOT_AI_CONNECT_TIMEOUT_SECONDS=5
BUDBOT_AI_MAX_OUTPUT_TOKENS=800
BUDBOT_AI_CAPABILITY_TEXT_GENERATION=true
BUDBOT_AI_CAPABILITY_TOOL_CALLING=false
BUDBOT_AI_CAPABILITY_USAGE_REPORTING=false
BUDBOT_AI_CAPABILITY_TEMPERATURE=false
BUDBOT_AI_CAPABILITY_MAX_OUTPUT_TOKENS=true
BUDBOT_AI_CAPABILITY_STRUCTURED_OUTPUT=false
BUDBOT_AI_CAPABILITY_SYSTEM_ROLE=true
BUDBOT_AI_CAPABILITY_REASONING_CONTROL=false

# Used by the PostgreSQL container in docker-compose.dev.yml.
BUDBOT_DATABASE_NAME=budbot
BUDBOT_DATABASE_USER=budbot
BUDBOT_DATABASE_PASSWORD=budbot_dev
